{
  "id": "{{PROJECT_ID}}",
  "name": "{{PROJECT_NAME}}",
  "description": "{{PROJECT_DESCRIPTION}}",
  "agentAppVersion": 2,
  "createdAt": "{{CREATED_AT}}",
  "authMode": "none",
  "port": "{{PORT}}",
  "pbVersion": "0.39.7",
  "kitVersion": "0.6.0",
  "craftbotVersion": "",
  "pipeline": {
    "install": "npm install --ignore-scripts --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "pocketbase serve --http=127.0.0.1:{{PORT}} --dir pb/pb_data --hooksDir pb/pb_hooks --migrationsDir pb/pb_migrations --publicDir pb/pb_public",
    "health": "/api/health"
  },
  "capabilities": {
    "actions": [
      "list_google_calendar_events"
    ],
    "triggers": [
      "breakdown_requested",
      "day_plan_requested",
      "evening_checkin",
      "habit_help_requested",
      "inbox_sort_requested",
      "morning_note_due",
      "proposal_returned",
      "question_asked",
      "recap_requested"
    ],
    "external_hosts": [
      "api.open-meteo.com",
      "geocoding-api.open-meteo.com",
      "ipwho.is",
      "news.google.com"
    ]
  },
  "adapterVersion": "1.9.0"
}
