{
  "id": "word-improve",
  "name": "Word Improve",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "1.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "ai",
      "summary": "generate",
      "entities": []
    },
    {
      "name": "integrations",
      "summary": "status",
      "entities": []
    },
    {
      "name": "sessions",
      "summary": "list, get, result, create, regenerate, pick, delete",
      "entities": [
        "sessions"
      ]
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
