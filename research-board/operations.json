{
  "operations": [
    {
      "name": "app.guide",
      "description": "The boards, conventions (kinds of cards, links, tags, positions) and ready-to-run recipes for adding sources, summarizing cards, reviewing…",
      "destructive": false,
      "readOnly": true,
      "module": "app",
      "params": {}
    },
    {
      "name": "settings.get",
      "description": "The workspace name and whether added links get a preview (page title, description, image).",
      "destructive": false,
      "readOnly": true,
      "module": "settings",
      "params": {}
    },
    {
      "name": "settings.update",
      "description": "Rename the workspace and/or turn link previews on or off.",
      "destructive": false,
      "module": "settings",
      "params": {
        "title": {
          "type": "string",
          "description": "Workspace name"
        },
        "link_previews": {
          "type": "boolean",
          "description": "Read the title, description and preview image of links when they are added"
        }
      }
    },
    {
      "name": "summary.home",
      "description": "Home overview: boards with previews, cards by kind, cards added per day of a month, latest cards, top tags, and what is waiting on the AI…",
      "destructive": false,
      "readOnly": true,
      "module": "summary",
      "params": {
        "month": {
          "type": "string",
          "description": "YYYY-MM (default this month)"
        }
      }
    },
    {
      "name": "boards.list",
      "description": "Every board with its counts (cards, links, proposed links, cards by kind) and review state.",
      "destructive": false,
      "readOnly": true,
      "module": "boards",
      "params": {
        "preview": {
          "type": "boolean",
          "description": "Also return each board's card boxes and links for a thumbnail"
        }
      }
    },
    {
      "name": "boards.get",
      "description": "One board with all its cards (position, size, content, tags, summary) and links.",
      "destructive": false,
      "readOnly": true,
      "module": "boards",
      "params": {
        "board": {
          "type": "string",
          "required": true,
          "format": "ref:boards",
          "description": "Board id"
        },
        "paths": {
          "type": "boolean",
          "description": "Include file_path (absolute path on disk) for uploaded files"
        }
      }
    },
    {
      "name": "boards.create",
      "description": "Create a board.",
      "destructive": false,
      "module": "boards",
      "params": {
        "name": {
          "type": "string",
          "required": true,
          "description": "Board name"
        },
        "description": {
          "type": "string",
          "format": "multiline",
          "description": "What the board is for"
        },
        "color": {
          "type": "enum",
          "values": [
            "ink",
            "accent",
            "amber",
            "green",
            "blue",
            "violet",
            "red",
            "teal"
          ],
          "description": "Board color"
        }
      }
    },
    {
      "name": "boards.update",
      "description": "Rename a board, change its description or color, or store its last view.",
      "destructive": false,
      "module": "boards",
      "params": {
        "board": {
          "type": "string",
          "required": true,
          "format": "ref:boards",
          "description": "Board id"
        },
        "name": {
          "type": "string",
          "description": "New name"
        },
        "description": {
          "type": "string",
          "format": "multiline",
          "description": "New description"
        },
        "color": {
          "type": "enum",
          "values": [
            "ink",
            "accent",
            "amber",
            "green",
            "blue",
            "violet",
            "red",
            "teal"
          ],
          "description": "Board color"
        },
        "viewport": {
          "type": "string",
          "format": "json",
          "description": "Last view as JSON: {\"x\":0,\"y\":0,\"zoom\":1}"
        }
      }
    },
    {
      "name": "boards.delete",
      "description": "Delete a board with all its cards and links, for good.",
      "destructive": true,
      "module": "boards",
      "params": {
        "board": {
          "type": "string",
          "required": true,
          "format": "ref:boards",
          "description": "Board id"
        }
      }
    },
    {
      "name": "boards.duplicate",
      "description": "Copy a board with its cards (and their files) and links.",
      "destructive": false,
      "module": "boards",
      "params": {
        "board": {
          "type": "string",
          "required": true,
          "format": "ref:boards",
          "description": "Board id"
        },
        "name": {
          "type": "string",
          "description": "Name of the copy (default \"<name> copy\")"
        }
      }
    },
    {
      "name": "boards.export",
      "description": "A board as a Markdown document: sections with their cards, other cards, then the links as sentences.",
      "destructive": false,
      "readOnly": true,
      "module": "boards",
      "params": {
        "board": {
          "type": "string",
          "required": true,
          "format": "ref:boards",
          "description": "Board id"
        }
      }
    },
    {
      "name": "cards.list",
      "description": "Search cards across boards (sections excluded).",
      "destructive": false,
      "readOnly": true,
      "module": "cards",
      "params": {
        "q": {
          "type": "string",
          "description": "Words to find in title, text, url, source, summary or tags"
        },
        "board": {
          "type": "string",
          "format": "ref:boards",
          "description": "Only this board"
        },
        "kind": {
          "type": "enum",
          "values": [
            "note",
            "link",
            "image",
            "video",
            "youtube",
            "doc",
            "quote",
            "section"
          ],
          "description": "Only this kind"
        },
        "tag": {
          "type": "string",
          "description": "Only cards with this tag"
        },
        "starred": {
          "type": "boolean",
          "description": "Only starred cards"
        },
        "digest": {
          "type": "enum",
          "values": [
            "any",
            "none",
            "waiting",
            "reading",
            "done",
            "failed"
          ],
          "description": "Filter by summary state"
        },
        "added_by": {
          "type": "enum",
          "values": [
            "app",
            "agent"
          ],
          "description": "Only cards added by the app (the person) or the AI agent"
        },
        "sort": {
          "type": "enum",
          "values": [
            "newest",
            "oldest",
            "title",
            "updated"
          ],
          "description": "Order"
        },
        "limit": {
          "type": "number",
          "description": "At most this many (default 100, max 500)"
        },
        "offset": {
          "type": "number",
          "description": "Skip this many"
        },
        "paths": {
          "type": "boolean",
          "description": "Include file_path for uploaded files"
        }
      }
    },
    {
      "name": "cards.get",
      "description": "One card with its links (each with the card at the other end) and file_path when it holds a file.",
      "destructive": false,
      "readOnly": true,
      "module": "cards",
      "params": {
        "card": {
          "type": "string",
          "required": true,
          "format": "ref:cards",
          "description": "Card id"
        }
      }
    },
    {
      "name": "cards.preview",
      "description": "Read a url's preview without saving anything: the kind it would make, title, description, site, image.",
      "destructive": false,
      "readOnly": true,
      "module": "cards",
      "params": {
        "url": {
          "type": "string",
          "required": true,
          "description": "https://... address"
        }
      }
    },
    {
      "name": "cards.add",
      "description": "Add a card to a board.",
      "destructive": false,
      "module": "cards",
      "params": {
        "board": {
          "type": "string",
          "required": true,
          "format": "ref:boards",
          "description": "Board id"
        },
        "kind": {
          "type": "enum",
          "values": [
            "note",
            "link",
            "image",
            "video",
            "youtube",
            "doc",
            "quote",
            "section"
          ],
          "description": "Card kind"
        },
        "title": {
          "type": "string",
          "description": "Title (links and videos get the page title when left out)"
        },
        "body": {
          "type": "string",
          "format": "multiline",
          "description": "Note text, the quoted passage of a quote, or your note about a link or file"
        },
        "url": {
          "type": "string",
          "description": "https://... address of the page, video, image or document"
        },
        "path": {
          "type": "string",
          "description": "Absolute path of a file on this computer to upload (image, video or document)"
        },
        "source": {
          "type": "string",
          "description": "Author or work a quote comes from"
        },
        "tags": {
          "type": "string",
          "description": "Tags: JSON list or comma-separated words"
        },
        "color": {
          "type": "enum",
          "values": [
            "plain",
            "amber",
            "green",
            "blue",
            "violet",
            "red",
            "teal",
            "accent"
          ],
          "description": "Card color"
        },
        "starred": {
          "type": "boolean",
          "description": "Star the card"
        },
        "x": {
          "type": "number",
          "description": "Left edge (world coordinates)"
        },
        "y": {
          "type": "number",
          "description": "Top edge"
        },
        "w": {
          "type": "number",
          "description": "Width (120 to 4000)"
        },
        "h": {
          "type": "number",
          "description": "Height (60 to 4000)"
        },
        "near_x": {
          "type": "number",
          "description": "Place at the free spot nearest this x"
        },
        "near_y": {
          "type": "number",
          "description": "Place at the free spot nearest this y"
        },
        "preview": {
          "type": "boolean",
          "description": "Read the page for a preview (default true)"
        }
      }
    },
    {
      "name": "cards.update",
      "description": "Change a card's content, tags, color, star, position or size.",
      "destructive": false,
      "module": "cards",
      "params": {
        "card": {
          "type": "string",
          "required": true,
          "format": "ref:cards",
          "description": "Card id"
        },
        "title": {
          "type": "string",
          "description": "Title"
        },
        "body": {
          "type": "string",
          "format": "multiline",
          "description": "Text"
        },
        "url": {
          "type": "string",
          "description": "https://... address"
        },
        "source": {
          "type": "string",
          "description": "Source of a quote"
        },
        "tags": {
          "type": "string",
          "description": "Replace the tags: JSON list or comma-separated words"
        },
        "color": {
          "type": "enum",
          "values": [
            "plain",
            "amber",
            "green",
            "blue",
            "violet",
            "red",
            "teal",
            "accent"
          ],
          "description": "Card color"
        },
        "starred": {
          "type": "boolean",
          "description": "Star or unstar"
        },
        "x": {
          "type": "number",
          "description": "Left edge"
        },
        "y": {
          "type": "number",
          "description": "Top edge"
        },
        "w": {
          "type": "number",
          "description": "Width"
        },
        "h": {
          "type": "number",
          "description": "Height"
        },
        "refresh_preview": {
          "type": "boolean",
          "description": "Read the link's page again"
        }
      }
    },
    {
      "name": "cards.move",
      "description": "Move and/or resize many cards at once.",
      "destructive": false,
      "module": "cards",
      "params": {
        "positions": {
          "type": "string",
          "required": true,
          "format": "json",
          "description": "JSON list: [{\"card\":\"<id>\",\"x\":0,\"y\":0,\"w\":260,\"h\":160}] (w and h optional)"
        },
        "front": {
          "type": "boolean",
          "description": "Also bring the moved cards to the front"
        }
      }
    },
    {
      "name": "cards.delete",
      "description": "Move cards to the trash (their links are hidden).",
      "destructive": true,
      "module": "cards",
      "params": {
        "ids": {
          "type": "string",
          "required": true,
          "format": "json",
          "description": "JSON list of card ids"
        }
      }
    },
    {
      "name": "cards.restore",
      "description": "Bring trashed cards back (with their links).",
      "destructive": false,
      "module": "cards",
      "params": {
        "ids": {
          "type": "string",
          "required": true,
          "format": "json",
          "description": "JSON list of card ids"
        }
      }
    },
    {
      "name": "cards.duplicate",
      "description": "Copy cards (and the links among them) on their board, slightly offset.",
      "destructive": false,
      "module": "cards",
      "params": {
        "ids": {
          "type": "string",
          "required": true,
          "format": "json",
          "description": "JSON list of card ids from one board"
        }
      }
    },
    {
      "name": "cards.transfer",
      "description": "Move or copy cards to another board.",
      "destructive": false,
      "module": "cards",
      "params": {
        "ids": {
          "type": "string",
          "required": true,
          "format": "json",
          "description": "JSON list of card ids"
        },
        "board": {
          "type": "string",
          "required": true,
          "format": "ref:boards",
          "description": "Target board id"
        },
        "mode": {
          "type": "enum",
          "values": [
            "move",
            "copy"
          ],
          "description": "move (default) or copy"
        }
      }
    },
    {
      "name": "cards.tag",
      "description": "Add and/or remove tags on many cards.",
      "destructive": false,
      "module": "cards",
      "params": {
        "ids": {
          "type": "string",
          "required": true,
          "format": "json",
          "description": "JSON list of card ids"
        },
        "add": {
          "type": "string",
          "description": "Tags to add: JSON list or comma-separated"
        },
        "remove": {
          "type": "string",
          "description": "Tags to remove: JSON list or comma-separated"
        }
      }
    },
    {
      "name": "tags.list",
      "description": "Every tag in use with how many cards carry it, most used first.",
      "destructive": false,
      "readOnly": true,
      "module": "tags",
      "params": {}
    },
    {
      "name": "tags.rename",
      "description": "Rename a tag on every card (merges into an existing tag of that name).",
      "destructive": false,
      "module": "tags",
      "params": {
        "tag": {
          "type": "string",
          "required": true,
          "description": "Current tag"
        },
        "to": {
          "type": "string",
          "required": true,
          "description": "New tag"
        }
      }
    },
    {
      "name": "tags.delete",
      "description": "Remove a tag from every card (the cards stay).",
      "destructive": true,
      "module": "tags",
      "params": {
        "tag": {
          "type": "string",
          "required": true,
          "description": "Tag to remove"
        }
      }
    },
    {
      "name": "links.add",
      "description": "Link two cards on the same board.",
      "destructive": false,
      "module": "links",
      "params": {
        "source": {
          "type": "string",
          "required": true,
          "format": "ref:cards",
          "description": "Card the arrow starts from"
        },
        "target": {
          "type": "string",
          "required": true,
          "format": "ref:cards",
          "description": "Card the arrow points to"
        },
        "kind": {
          "type": "enum",
          "values": [
            "relates",
            "supports",
            "contradicts",
            "leads"
          ],
          "description": "relates (default), supports, contradicts or leads (to)"
        },
        "label": {
          "type": "string",
          "description": "Short label shown on the link"
        },
        "proposed": {
          "type": "boolean",
          "description": "A proposal the person confirms or rejects"
        },
        "reason": {
          "type": "string",
          "description": "Why (shown with a proposal)"
        }
      }
    },
    {
      "name": "links.update",
      "description": "Change a link's kind or label, or flip its direction.",
      "destructive": false,
      "module": "links",
      "params": {
        "link": {
          "type": "string",
          "required": true,
          "format": "ref:links",
          "description": "Link id"
        },
        "kind": {
          "type": "enum",
          "values": [
            "relates",
            "supports",
            "contradicts",
            "leads"
          ],
          "description": "Link kind"
        },
        "label": {
          "type": "string",
          "description": "Label"
        },
        "flip": {
          "type": "boolean",
          "description": "Reverse the direction"
        }
      }
    },
    {
      "name": "links.delete",
      "description": "Remove a link (the cards stay).",
      "destructive": true,
      "module": "links",
      "params": {
        "link": {
          "type": "string",
          "required": true,
          "format": "ref:links",
          "description": "Link id"
        }
      }
    },
    {
      "name": "links.decide",
      "description": "Confirm or reject proposed links: give ids, or a board to decide all of its proposals.",
      "destructive": false,
      "module": "links",
      "params": {
        "decision": {
          "type": "enum",
          "values": [
            "confirm",
            "reject"
          ],
          "required": true,
          "description": "confirm or reject"
        },
        "ids": {
          "type": "string",
          "format": "json",
          "description": "JSON list of proposed link ids"
        },
        "board": {
          "type": "string",
          "format": "ref:boards",
          "description": "Decide every proposal on this board"
        }
      }
    },
    {
      "name": "digests.request",
      "description": "Ask the AI agent to summarize a card (it reads the page, file or video).",
      "destructive": false,
      "module": "digests",
      "params": {
        "card": {
          "type": "string",
          "required": true,
          "format": "ref:cards",
          "description": "Card id"
        }
      }
    },
    {
      "name": "digests.cancel",
      "description": "Withdraw a summary ask that is still waiting.",
      "destructive": false,
      "module": "digests",
      "params": {
        "card": {
          "type": "string",
          "required": true,
          "format": "ref:cards",
          "description": "Card id"
        }
      }
    },
    {
      "name": "digests.clear",
      "description": "Remove a card's summary.",
      "destructive": true,
      "module": "digests",
      "params": {
        "card": {
          "type": "string",
          "required": true,
          "format": "ref:cards",
          "description": "Card id"
        }
      }
    },
    {
      "name": "digests.list",
      "description": "Cards by summary state (default waiting), with file_path for uploaded files.",
      "destructive": false,
      "readOnly": true,
      "module": "digests",
      "params": {
        "state": {
          "type": "enum",
          "values": [
            "waiting",
            "reading",
            "failed",
            "done"
          ],
          "description": "Summary state"
        }
      }
    },
    {
      "name": "digests.start",
      "description": "Take a waiting card before reading it.",
      "destructive": false,
      "module": "digests",
      "params": {
        "card": {
          "type": "string",
          "required": true,
          "format": "ref:cards",
          "description": "Card id"
        }
      }
    },
    {
      "name": "digests.complete",
      "description": "Save the summary of a card you read (3 to 6 sentences).",
      "destructive": false,
      "module": "digests",
      "params": {
        "card": {
          "type": "string",
          "required": true,
          "format": "ref:cards",
          "description": "Card id"
        },
        "summary": {
          "type": "string",
          "required": true,
          "format": "multiline",
          "description": "The summary"
        },
        "title": {
          "type": "string",
          "description": "Better title (optional)"
        },
        "tags": {
          "type": "string",
          "description": "Tags to add: JSON list or comma-separated"
        }
      }
    },
    {
      "name": "digests.fail",
      "description": "Report that a card cannot be summarized, with a reason the person can act on.",
      "destructive": false,
      "module": "digests",
      "params": {
        "card": {
          "type": "string",
          "required": true,
          "format": "ref:cards",
          "description": "Card id"
        },
        "reason": {
          "type": "string",
          "required": true,
          "description": "What you saw and what the person can do"
        }
      }
    },
    {
      "name": "reviews.request",
      "description": "Ask the AI agent to review a board: notes on what is missing, proposed links and a short review.",
      "destructive": false,
      "module": "reviews",
      "params": {
        "board": {
          "type": "string",
          "required": true,
          "format": "ref:boards",
          "description": "Board id"
        },
        "focus": {
          "type": "string",
          "format": "multiline",
          "description": "What the review should look at (optional)"
        }
      }
    },
    {
      "name": "reviews.cancel",
      "description": "Withdraw a review ask that is still waiting.",
      "destructive": false,
      "module": "reviews",
      "params": {
        "board": {
          "type": "string",
          "required": true,
          "format": "ref:boards",
          "description": "Board id"
        }
      }
    },
    {
      "name": "reviews.dismiss",
      "description": "Hide a finished or failed review from the board.",
      "destructive": false,
      "module": "reviews",
      "params": {
        "board": {
          "type": "string",
          "required": true,
          "format": "ref:boards",
          "description": "Board id"
        }
      }
    },
    {
      "name": "reviews.list",
      "description": "Boards by review state (default waiting), with the person's focus.",
      "destructive": false,
      "readOnly": true,
      "module": "reviews",
      "params": {
        "state": {
          "type": "enum",
          "values": [
            "waiting",
            "working",
            "failed",
            "done"
          ],
          "description": "Review state"
        }
      }
    },
    {
      "name": "reviews.start",
      "description": "Take a waiting board before reviewing it.",
      "destructive": false,
      "module": "reviews",
      "params": {
        "board": {
          "type": "string",
          "required": true,
          "format": "ref:boards",
          "description": "Board id"
        }
      }
    },
    {
      "name": "reviews.complete",
      "description": "Save the review of a board (themes, gaps, contradictions, next steps; under 1500 characters).",
      "destructive": false,
      "module": "reviews",
      "params": {
        "board": {
          "type": "string",
          "required": true,
          "format": "ref:boards",
          "description": "Board id"
        },
        "summary": {
          "type": "string",
          "required": true,
          "format": "multiline",
          "description": "The review"
        }
      }
    },
    {
      "name": "reviews.fail",
      "description": "Report that a board could not be reviewed, with a reason.",
      "destructive": false,
