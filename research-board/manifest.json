{
  "id": "research-board",
  "name": "Research Board",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "2.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "app",
      "summary": "guide",
      "entities": []
    },
    {
      "name": "settings",
      "summary": "get, update",
      "entities": [
        "settings"
      ]
    },
    {
      "name": "summary",
      "summary": "home",
      "entities": []
    },
    {
      "name": "boards",
      "summary": "list, get, create, update, delete, duplicate, export",
      "entities": [
        "boards"
      ]
    },
    {
      "name": "cards",
      "summary": "list, get, preview, add, update, move, delete, restore…",
      "entities": [
        "cards"
      ]
    },
    {
      "name": "tags",
      "summary": "list, rename, delete",
      "entities": []
    },
    {
      "name": "links",
      "summary": "add, update, delete, decide",
      "entities": [
        "links"
      ]
    },
    {
      "name": "digests",
      "summary": "request, cancel, clear, list, start, complete, fail",
      "entities": []
    },
    {
      "name": "reviews",
      "summary": "request, cancel, dismiss, list, start, complete, fail",
      "entities": []
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
