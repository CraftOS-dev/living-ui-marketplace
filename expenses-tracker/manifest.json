{
  "id": "expenses-tracker",
  "name": "Expenses Tracker",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "1.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "app",
      "summary": "guide",
      "entities": []
    },
    {
      "name": "settings",
      "summary": "get, update",
      "entities": [
        "settings"
      ]
    },
    {
      "name": "summary",
      "summary": "month, trend",
      "entities": []
    },
    {
      "name": "expenses",
      "summary": "list, get, add, add-many, update, delete, delete-many…",
      "entities": [
        "expenses"
      ]
    },
    {
      "name": "categories",
      "summary": "list, add, update, delete",
      "entities": [
        "categories"
      ]
    },
    {
      "name": "receipts",
      "summary": "list, get, add, start, complete, fail, retry, delete",
      "entities": [
        "receipts"
      ]
    },
    {
      "name": "import",
      "summary": "preview, run, list, undo",
      "entities": [
        "imports"
      ]
    },
    {
      "name": "export",
      "summary": "csv",
      "entities": []
    },
    {
      "name": "recurring",
      "summary": "list, add, update, delete, run-due",
      "entities": [
        "recurring"
      ]
    },
    {
      "name": "fx",
      "summary": "rate",
      "entities": []
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
