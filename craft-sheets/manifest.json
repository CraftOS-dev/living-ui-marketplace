{
  "id": "craft-sheets",
  "name": "Craft Sheets",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "1.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "app",
      "summary": "guide",
      "entities": []
    },
    {
      "name": "sheets",
      "summary": "list, get, create, rename, delete, freeze, import-csv…",
      "entities": []
    },
    {
      "name": "cells",
      "summary": "read, find, set, paste, clear, format, fill, copy, replace",
      "entities": []
    },
    {
      "name": "rows",
      "summary": "add, insert, delete, resize",
      "entities": []
    },
    {
      "name": "columns",
      "summary": "add, insert, delete, update",
      "entities": []
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
