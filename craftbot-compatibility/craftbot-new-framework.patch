+    async def test_cancel_during_dequeue_handoff_never_executes(self):
+        from app.triggers.runtime import SessionRuntimeManager
+        from app.triggers.service import TriggerService, TriggerSpec
+        from app.triggers.store import TriggerStore
+        with tempfile.TemporaryDirectory() as tmp:
+            react = AsyncMock()
+            runtime = SessionRuntimeManager(react)
+            service = TriggerService(TriggerStore(str(Path(tmp) / "triggers.db")), runtime)
+            queued = await service.emit(TriggerSpec(source="agent_app_app_request", description="Must not execute", session_id="race"))
+            queue = runtime._queues["race"]
+            popped, release, checked = asyncio.Event(), asyncio.Event(), asyncio.Event()
+            original = queue.pop_due_batch
+            async def held(**kwargs):
+                popped.set()
+                await release.wait()
+                return await original(**kwargs)
+            queue.pop_due_batch = held
+            original_check = service.is_dispatchable
+            def observe(trigger):
+                result = original_check(trigger)
+                checked.set()
+                return result
+            service.is_dispatchable = observe
+            await runtime.start()
+            try:
+                await asyncio.wait_for(popped.wait(), 2)
+                mgr = SimpleNamespace(agent_app_dir=Path(tmp), _trigger_service=service)
+                await FrameworkHost(mgr).cancel_run({"trigger":queued.trigger_id,"session":"race"})
+                release.set()
+                await asyncio.wait_for(checked.wait(), 2)
+                react.assert_not_awaited()
+                self.assertEqual(service._store.get(queued.trigger_id)["resolution"], "cancelled")
+            finally:
+                release.set()
+                await runtime.stop()
+
