+"""Run: python -m unittest app.agent_app.test_framework_host -v"""
+import asyncio
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+from app.agent_app.manager import AgentAppManager, AgentAppProject
+from app.agent_app.framework_host import FrameworkHost, is_framework_manifest
+
+
+class FrameworkTests(unittest.IsolatedAsyncioTestCase):
+    def test_classification_preserves_v2(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            for manifest, expected in [
+                ({"agentAppVersion": 2}, True),
+                ({"livingUIVersion": 2}, True),
+                ({"agentAppVersion": "0.1.0"}, False),
+                ({"agentAppVersion": "0.1.0", "adapterVersion": "0.1.0", "modules": [{"name": "workspace"}], "pipeline": {}}, True),
+                ({"agentAppVersion": "0.2.0", "adapterVersion": "0.1.0", "modules": ["workspace"], "pipeline": {}}, False),
+            ]:
+                (root / "manifest.json").write_text(json.dumps(manifest))
+                self.assertEqual(AgentAppManager._find_project_root(root) == root, expected)
+
+    async def test_import_uses_framework_and_persists_format(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            mgr = AgentAppManager(Path(tmp) / "workspace")
+            src = Path(tmp) / "donor"
+            src.mkdir()
+            manifest = {"id": "donor", "name": "Test", "port": 8097, "agentAppVersion": "0.1.0", "adapterVersion": "0.1.0", "modules": [{"name": "workspace"}], "pipeline": {}}
+            (src / "manifest.json").write_text(json.dumps(manifest))
+            for name in (".agent-token", ".principal", ".superuser"):
