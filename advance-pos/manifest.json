    {
      "name": "settings",
      "summary": "get, update",
      "entities": [
        "settings"
      ]
    },
    {
      "name": "permissions",
      "summary": "update",
      "entities": []
    },
    {
      "name": "registers",
      "summary": "list, save, focus",
      "entities": [
        "registers"
      ]
    },
    {
      "name": "display",
      "summary": "get",
      "entities": []
    },
    {
      "name": "staff",
      "summary": "list, save, clock",
      "entities": [
        "staff"
      ]
    },
    {
      "name": "timeclock",
      "summary": "list, save",
      "entities": [
        "timeclock"
      ]
    },
    {
      "name": "catalog",
      "summary": "register",
      "entities": []
    },
    {
      "name": "categories",
      "summary": "list, save",
      "entities": [
        "categories"
      ]
    },
    {
      "name": "taxes",
      "summary": "list, save",
      "entities": [
        "taxes"
      ]
    },
    {
      "name": "modifiers",
      "summary": "list, save",
      "entities": []
    },
    {
      "name": "products",
      "summary": "list, get, lookup, save, import, export",
      "entities": [
        "modifier_groups",
        "products",
        "variants"
      ]
    },
    {
      "name": "stock",
      "summary": "levels, change, moves",
      "entities": [
        "stock_moves"
      ]
    },
    {
      "name": "customers",
      "summary": "list, get, save, adjust, import, export",
      "entities": [
        "customers"
      ]
    },
    {
      "name": "giftcards",
      "summary": "list, get, save, adjust",
      "entities": []
    },
    {
      "name": "discounts",
      "summary": "list, save",
      "entities": [
        "discounts"
      ]
    },
    {
      "name": "orders",
      "summary": "list, get, add, line, remove, update, return, void, complete…",
      "entities": [
        "gift_cards",
        "orders"
      ]
    },
    {
      "name": "payments",
      "summary": "add, void",
      "entities": [
        "payments"
      ]
    },
    {
      "name": "shifts",
      "summary": "current, open, cash, close, list, get",
      "entities": [
        "shifts"
      ]
    },
    {
      "name": "reports",
      "summary": "summary, breakdown, export",
      "entities": []
    },
    {
      "name": "calendar",
      "summary": "list",
      "entities": [
        "events"
      ]
    },
    {
      "name": "requests",
      "summary": "create, list, get, update",
      "entities": [
        "requests"
      ]
    },
    {
      "name": "records",
      "summary": "delete",
      "entities": [
        "cash_moves",
        "order_lines",
        "account_moves"
      ]
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
