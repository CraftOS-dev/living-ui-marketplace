{
  "id": "advance-pos",
  "name": "Advance POS",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "1.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "app",
      "summary": "guide, status",
      "entities": []
    },
    {
      "name": "setup",
      "summary": "status, complete",
      "entities": []
    },
    {
