{
  "id": "pdf-splitter",
  "name": "PDF Splitter",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "1.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "pdfs",
      "summary": "list, get, upload, delete",
      "entities": [
        "pdfs"
      ]
    },
    {
      "name": "splits",
      "summary": "preview, create, get",
      "entities": []
    },
    {
      "name": "records",
      "summary": "the app's other stored records",
      "entities": [
        "split_jobs"
      ]
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
