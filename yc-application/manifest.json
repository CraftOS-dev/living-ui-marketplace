{
  "id": "yc-application",
  "name": "YC Application",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "1.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "app",
      "summary": "guide, status, founder-todo",
      "entities": []
    },
    {
      "name": "pipeline",
      "summary": "get",
      "entities": []
    },
    {
      "name": "settings",
      "summary": "get, update",
      "entities": [
        "settings"
      ]
    },
    {
      "name": "activity",
      "summary": "list",
      "entities": [
        "activity"
      ]
    },
    {
      "name": "questions",
      "summary": "list",
      "entities": []
    },
    {
      "name": "answers",
      "summary": "list, get, set, dismiss, set-many, find, need, recheck",
      "entities": [
        "answers"
      ]
    },
    {
      "name": "founders",
      "summary": "list, get, add, update, reorder, remove",
      "entities": [
        "founders"
      ]
    },
    {
      "name": "sources",
      "summary": "list, get, add, upload, update, remove",
      "entities": [
        "sources"
      ]
    },
    {
      "name": "review",
      "summary": "checks, odds",
      "entities": []
    },
    {
      "name": "gather",
      "summary": "begin, finish",
      "entities": []
    },
    {
      "name": "messages",
      "summary": "list, reply",
      "entities": [
        "messages"
      ]
    },
    {
      "name": "submit",
      "summary": "ready, packet, progress, status",
      "entities": []
    },
    {
      "name": "export",
      "summary": "markdown",
      "entities": []
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
