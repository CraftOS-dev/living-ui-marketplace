{
  "id": "newsletter-tool",
  "name": "Newsletter Tool",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "1.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "app",
      "summary": "guide",
      "entities": []
    },
    {
      "name": "dashboard",
      "summary": "get",
      "entities": []
    },
    {
      "name": "subscribers",
      "summary": "list, add, import, export",
      "entities": [
        "subscribers"
      ]
    },
    {
      "name": "templates",
      "summary": "list, get, create, update, duplicate, delete",
      "entities": []
    },
    {
      "name": "campaigns",
      "summary": "list, get, preview, create, update, duplicate, delete…",
      "entities": []
    },
    {
      "name": "blocks",
      "summary": "edit",
      "entities": []
    },
    {
      "name": "settings",
      "summary": "get, update",
      "entities": []
    },
    {
      "name": "ai",
      "summary": "draft",
      "entities": []
    },
    {
      "name": "integrations",
      "summary": "status",
      "entities": []
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
