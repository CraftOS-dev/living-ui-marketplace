{
  "operations": [
    {
      "name": "habits.clear-entries",
      "description": "Delete ALL daily entries of one habit (its full history) and return how many were removed.",
      "destructive": true,
      "module": "habits",
      "params": {
        "habit_id": {
          "type": "string",
          "required": true,
          "description": "The habit record id to reset."
        }
      }
    },
    {
      "name": "app.guide",
      "description": "What the app is, habit types, how days, completion and streaks work, valid colours and icons, and recipes for common jobs.",
      "destructive": false,
      "readOnly": true,
      "module": "app",
      "params": {}
    },
    {
      "name": "app.state",
      "description": "The main screen: done today, this week's rate, streaks of 7+ days, top streak, category chips, each habit with today's value and streak.",
      "destructive": false,
      "readOnly": true,
      "module": "app",
      "params": {
        "search": {
          "type": "string",
          "description": "Only habits whose name contains this text (the search box)."
        },
        "category_id": {
          "type": "string",
          "description": "Only habits in this category (a category chip)."
        },
        "include_archived": {
          "type": "boolean",
          "description": "Also list archived habits (the app hides them). Default false."
        }
      }
    },
    {
      "name": "habits.get",
      "description": "One habit's detail panel: settings, today's entry, current and best streak, 30-day rate, total completions and the 30-day trend.",
      "destructive": false,
      "readOnly": true,
      "module": "habits",
      "params": {
        "habit_id": {
          "type": "string",
          "required": true,
          "description": "The habit id."
        }
      }
    },
    {
      "name": "habits.history",
      "description": "One habit's heatmap: value, completed, intensity and note per day for the last N days.",
      "destructive": false,
      "readOnly": true,
      "module": "habits",
      "params": {
        "habit_id": {
          "type": "string",
          "required": true,
          "description": "The habit id."
        },
        "days": {
          "type": "number",
          "description": "How many days back, 7-730. Default 365."
        },
        "all_days": {
          "type": "boolean",
          "description": "List every day, empty ones too. Default false."
        }
      }
    },
    {
      "name": "habits.create",
      "description": "Add a habit (the New habit form).",
      "destructive": false,
      "module": "habits",
      "params": {
        "name": {
          "type": "string",
          "required": true,
          "description": "Habit name."
        },
        "type": {
          "type": "enum",
          "values": [
            "binary",
            "count",
            "duration",
            "negative"
          ],
          "description": "Default binary. negative is an avoid habit (a habit to break)."
        },
        "target": {
          "type": "number",
          "description": "Per-day target, above 0. Required for count and duration."
        },
        "unit": {
          "type": "string",
          "description": "count/duration only. Default reps (count) or min (duration)."
        },
        "description": {
          "type": "string",
          "description": "Why this habit matters."
        },
        "color": {
          "type": "enum",
          "values": [
            "#EF4444",
