    {
      "name": "habits.archive",
      "description": "Archive a habit (hidden from list and dashboard, history kept) or bring it back with archived=false.",
      "destructive": false,
      "module": "habits",
      "params": {
        "habit_id": {
          "type": "string",
          "required": true,
          "description": "The habit id."
        },
        "archived": {
          "type": "boolean",
          "description": "true archives (default), false brings it back."
        }
      }
    },
    {
      "name": "habits.reorder",
      "description": "Set the list order: habit ids top first (pass every active habit).",
      "destructive": false,
      "module": "habits",
      "params": {
        "habit_ids": {
          "type": "string",
          "required": true,
          "description": "JSON list of habit ids in the new order, e.g. [\"id1\",\"id2\"]."
        }
      }
    },
    {
      "name": "habits.delete",
      "description": "Delete a habit and all of its history.",
      "destructive": true,
      "module": "habits",
      "params": {
        "habit_id": {
          "type": "string",
          "required": true,
          "description": "The habit id."
        }
      }
    },
    {
      "name": "entries.set",
      "description": "Set a day's value and/or note (default today; last 365 days).",
      "destructive": false,
      "module": "entries",
      "params": {
        "habit_id": {
          "type": "string",
          "required": true,
          "description": "The habit id."
        },
        "day": {
          "type": "string",
          "description": "YYYY-MM-DD within the last 365 days. Default today."
        },
        "value": {
          "type": "number",
          "description": "binary/negative: 0 or 1. count/duration: 0 or more."
        },
        "note": {
          "type": "string",
          "description": "Note for the day; empty clears it."
        }
      }
    },
    {
      "name": "entries.mark",
      "description": "Mark a day done (binary 1, count/duration its target) or not done (0); default today.",
      "destructive": false,
      "module": "entries",
      "params": {
        "habit_id": {
          "type": "string",
          "required": true,
          "description": "The habit id."
        },
        "done": {
          "type": "boolean",
          "required": true,
          "description": "true = done, false = not done."
        },
        "day": {
          "type": "string",
          "description": "YYYY-MM-DD within the last 365 days. Default today."
        }
      }
    },
    {
      "name": "entries.add",
      "description": "Add to a count/duration habit's day value (negative subtracts, never below 0); default today.",
      "destructive": false,
      "module": "entries",
      "params": {
        "habit_id": {
          "type": "string",
          "required": true,
          "description": "The habit id."
        },
        "amount": {
          "type": "number",
          "description": "How much to add; negative subtracts. Default 1."
        },
        "day": {
          "type": "string",
          "description": "YYYY-MM-DD within the last 365 days. Default today."
        }
      }
    },
    {
      "name": "categories.create",
      "description": "Add a category (name and palette colour); it goes last among the chips.",
      "destructive": false,
      "module": "categories",
      "params": {
        "name": {
          "type": "string",
          "required": true,
          "description": "Category name."
        },
        "color": {
          "type": "enum",
          "values": [
            "#EF4444",
            "#F97316",
            "#F59E0B",
            "#EAB308",
            "#84CC16",
            "#22C55E",
            "#10B981",
            "#14B8A6",
            "#06B6D4",
            "#0EA5E9",
            "#3B82F6",
            "#6366F1",
            "#8B5CF6",
            "#A855F7",
            "#D946EF",
            "#EC4899",
            "#F43F5E",
            "#737373"
          ],
          "description": "Palette colour. Default #10B981."
        }
      }
    },
    {
      "name": "categories.delete",
      "description": "Delete a category; its habits become Uncategorized (they and their history are kept).",
      "destructive": true,
      "module": "categories",
      "params": {
        "category_id": {
          "type": "string",
          "required": true,
          "description": "The category id."
        }
      }
    }
  ]
}
