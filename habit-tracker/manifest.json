{
  "id": "habit-tracker",
  "name": "Habit Tracker",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "1.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "habits",
      "summary": "clear-entries, get, history, create, update, archive…",
      "entities": [
        "habits"
      ]
    },
    {
      "name": "app",
      "summary": "guide, state",
      "entities": []
    },
    {
      "name": "entries",
      "summary": "set, mark, add",
      "entities": [
        "entries"
      ]
    },
    {
      "name": "categories",
      "summary": "create, delete",
      "entities": [
        "categories"
      ]
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
