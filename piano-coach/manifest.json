{
  "id": "piano-coach",
  "name": "Piano Coach",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "1.1.0",
  "authMode": "none",
  "modules": [
    {
      "name": "app",
      "summary": "guide, state, context",
      "entities": [
        "lessons"
      ]
    },
    {
      "name": "settings",
      "summary": "get",
      "entities": [
        "settings"
      ]
    },
    {
      "name": "songs",
      "summary": "list, get, check, add, update",
      "entities": [
        "songs",
        "progress"
      ]
    },
    {
      "name": "runs",
      "summary": "list",
      "entities": [
        "runs"
      ]
    },
    {
      "name": "sessions",
      "summary": "list, get, review",
      "entities": [
        "sessions"
      ]
    },
    {
      "name": "review",
      "summary": "pack",
      "entities": []
    },
    {
      "name": "coach",
      "summary": "list, get, reply",
      "entities": [
        "messages"
      ]
    },
    {
      "name": "plan",
      "summary": "today, set",
      "entities": [
        "plans",
        "skills"
      ]
    },
    {
      "name": "stats",
      "summary": "home, song",
      "entities": []
    },
    {
      "name": "learn",
      "summary": "state",
      "entities": []
    },
    {
      "name": "drills",
      "summary": "list",
      "entities": [
        "drills"
      ]
    },
    {
      "name": "abc",
      "summary": "parse",
      "entities": []
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
