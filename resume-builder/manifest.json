{
  "id": "resume-builder",
  "name": "Resume Maker",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "1.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "app",
      "summary": "guide",
      "entities": []
    },
    {
      "name": "resumes",
      "summary": "list, get, score, export, create, import, duplicate, rename…",
      "entities": [
        "resume_state"
      ]
    },
    {
      "name": "style",
      "summary": "options, set-template, update",
      "entities": []
    },
    {
      "name": "layout",
      "summary": "set-visibility, move",
      "entities": []
    },
    {
      "name": "personal",
      "summary": "update, set-photo",
      "entities": []
    },
    {
      "name": "philosophy",
      "summary": "update",
      "entities": []
    },
    {
      "name": "experience",
      "summary": "add, update, remove",
      "entities": []
    },
    {
      "name": "education",
      "summary": "add, update, remove",
      "entities": []
    },
    {
      "name": "skills",
      "summary": "add, update, remove",
      "entities": []
    },
    {
      "name": "mytime",
      "summary": "add, update, remove",
      "entities": []
    },
    {
      "name": "achievements",
      "summary": "add, update, remove",
      "entities": []
    },
    {
      "name": "projects",
      "summary": "add, update, remove",
      "entities": []
    },
    {
      "name": "certifications",
      "summary": "add, update, remove",
      "entities": []
    },
    {
      "name": "publications",
      "summary": "add, update, remove",
      "entities": []
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
