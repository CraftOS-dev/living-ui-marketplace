{
  "operations": [
    {
      "name": "session.check",
      "description": "Whether a session token (sent in the X-Session-Token header) is still valid on this server.",
      "destructive": false,
      "readOnly": true,
      "module": "session",
      "params": {}
    },
    {
      "name": "meta",
      "description": "Catalog of event codes, status groups and office connection state (no secrets).",
      "destructive": false,
      "readOnly": true,
      "module": "meta",
      "params": {}
    },
    {
      "name": "onboarding.complete",
      "description": "Admin only. Set the organization name, vocabulary pack (general, entertainment, technology, consumer), home currency and jurisdictions of…",
      "destructive": false,
      "module": "onboarding",
      "params": {
        "org_name": {
          "type": "string",
          "required": true
        },
        "vocab_pack": {
          "type": "enum",
          "values": [
            "general",
            "entertainment",
            "technology",
            "consumer"
          ]
        },
        "home_currency": {
          "type": "string",
          "description": "ISO 4217 code, e.g. USD, EUR, JPY"
        },
        "jurisdictions": {
          "type": "string",
          "description": "JSON array of office codes, e.g. [\"US\",\"EP\",\"EM\",\"JP\",\"WO\"]"
        }
      }
    },
    {
      "name": "portfolio.summary",
      "description": "Counts of the portfolio by IP type and status group, deadlines overdue and due soon, inbox items waiting, renewal decisions pending…",
      "destructive": false,
      "module": "portfolio",
      "params": {}
    },
    {
      "name": "portfolio.search",
      "description": "Search matters, families, properties, works, agreements, people and inventions.",
      "destructive": false,
      "module": "portfolio",
      "params": {
        "q": {
          "type": "string",
          "required": true
        },
        "limit": {
          "type": "number"
        }
      }
    },
    {
      "name": "matters.preview-event",
      "description": "Show which deadlines an event would create (rule, dates, explanation, citation) without writing anything.",
      "destructive": false,
      "module": "matters",
      "params": {
        "matter_id": {
          "type": "string",
          "required": true
        },
        "subject_type": {
          "type": "enum",
          "values": [
            "matter",
            "agreement",
            "work"
          ]
        },
        "code": {
          "type": "string",
          "required": true,
          "description": "Event code from meta.event_codes, e.g. OA_NONFINAL, REGISTERED"
        },
        "date": {
          "type": "string",
          "required": true,
          "description": "YYYY-MM-DD"
        },
        "data": {
          "type": "string",
          "description": "JSON object; period_months or due_date for examiner-set periods"
        }
      }
    },
    {
      "name": "matters.record-event",
      "description": "Record an event on a matter (or agreement/work) and create its rule-based deadlines.",
      "destructive": false,
      "module": "matters",
      "params": {
        "matter_id": {
          "type": "string",
          "required": true
        },
        "subject_type": {
          "type": "enum",
          "values": [
            "matter",
            "agreement",
            "work"
          ]
        },
        "code": {
          "type": "string",
          "required": true
        },
        "date": {
          "type": "string",
          "required": true
        },
        "label": {
          "type": "string"
        },
        "data": {
          "type": "string",
          "description": "JSON object"
        },
        "select": {
          "type": "string",
          "description": "JSON array of proposal keys or rule codes to create"
        },
        "skip": {
          "type": "string",
          "description": "JSON array of proposal keys or rule codes to skip"
        },
