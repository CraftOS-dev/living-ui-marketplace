{
  "id": "markdown-tool",
  "name": "Markdown Editor",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "1.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "files",
      "summary": "list, read, write, create, upload, upload-overwrite, rename…",
      "entities": [
        "nodes"
      ]
    },
    {
      "name": "editor",
      "summary": "tabs",
      "entities": [
        "sessions"
      ]
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
