{
  "id": "trading-view",
  "name": "Trading View",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "2.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "app",
      "summary": "guide, context",
      "entities": []
    },
    {
      "name": "settings",
      "summary": "get, update",
      "entities": [
        "settings"
      ]
    },
    {
      "name": "market",
      "summary": "search, quotes, bars, info, news, events, health, live",
      "entities": [
        "symbols",
        "bars"
      ]
    },
    {
      "name": "indicators",
      "summary": "catalogue",
      "entities": []
    },
    {
      "name": "chart",
      "summary": "indicators, levels, explain",
      "entities": []
    },
    {
      "name": "workspaces",
      "summary": "list, get, create, update, delete, duplicate, activate…",
      "entities": [
        "workspaces"
      ]
    },
    {
      "name": "widgets",
      "summary": "add, update, layout, remove",
      "entities": [
        "widgets"
      ]
    },
    {
      "name": "charts",
      "summary": "set, add_indicator, remove_indicator",
      "entities": []
    },
    {
      "name": "watchlists",
      "summary": "list, get, create, update, delete, add, remove, move, item",
      "entities": [
        "watchlists"
      ]
    },
    {
      "name": "drawings",
      "summary": "list, add, update, delete, clear, adopt",
      "entities": [
        "drawings"
      ]
    },
    {
      "name": "alerts",
      "summary": "list, create, update, delete, events, seen, check, respond",
      "entities": [
        "alerts"
      ]
    },
    {
      "name": "analyses",
      "summary": "request, list, get, start, complete, fail, cancel, delete",
      "entities": [
        "analyses"
      ]
    },
    {
      "name": "screener",
      "summary": "universes, fields, run, heatmap",
      "entities": []
    },
    {
      "name": "screens",
      "summary": "list, save, delete",
      "entities": [
        "screens"
      ]
    },
    {
      "name": "activity",
      "summary": "list, undo, redo, runs, revert_run",
      "entities": [
        "activity"
      ]
    },
    {
      "name": "records",
      "summary": "the app's other stored records",
      "entities": [
        "watch_items",
        "alert_events"
      ]
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
