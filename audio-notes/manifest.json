{
  "id": "audio-notes",
  "name": "Audio Notes",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "1.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "notes",
      "summary": "list, get, create, import-audio, update, delete, duplicate…",
      "entities": [
        "notes"
      ]
    },
    {
      "name": "actions",
      "summary": "add, update, delete, clear-done, open",
      "entities": []
    },
    {
      "name": "digest",
      "summary": "week",
      "entities": []
    },
    {
      "name": "engine",
      "summary": "status, install",
      "entities": []
    },
    {
      "name": "records",
      "summary": "the app's other stored records",
      "entities": [
        "live_chunks"
      ]
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
