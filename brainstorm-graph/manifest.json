{
  "id": "brainstorm-graph",
  "name": "Brainstorm Graph",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "1.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "sessions",
      "summary": "summarize, outline, get, create, ai-explore",
      "entities": [
        "sessions"
      ]
    },
    {
      "name": "nodes",
      "summary": "add, edit, expand, ai-answer, delete",
      "entities": [
        "nodes"
      ]
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
