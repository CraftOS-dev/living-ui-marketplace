{
  "id": "invoice-tracker",
  "name": "Invoice & Subscription Tracker",
  "agentAppVersion": "0.1.0",
  "adapterVersion": "0.2.0",
  "appVersion": "1.0.0",
  "authMode": "none",
  "modules": [
    {
      "name": "invoices",
      "summary": "simulate-bill, list, get, add, delete",
      "entities": [
        "invoices"
      ]
    },
    {
      "name": "dashboard",
      "summary": "overview",
      "entities": []
    },
    {
      "name": "subscriptions",
      "summary": "list, add, set-status, delete",
      "entities": [
        "subscriptions"
      ]
    },
    {
      "name": "reports",
      "summary": "monthly, monthly-csv, yearly",
      "entities": []
    },
    {
      "name": "groups",
      "summary": "add, update, delete",
      "entities": [
        "groups"
      ]
    },
    {
      "name": "records",
      "summary": "the app's other stored records",
      "entities": [
        "activities"
      ]
    }
  ],
  "modificationLock": false,
  "capabilities": {
    "integrations": []
  },
  "pipeline": {
    "install": "node pb-fetch.mjs && npm --prefix frontend install --ignore-scripts --no-audit --no-fund",
    "build": "node pb-build.mjs",
    "start": "node pb-serve.mjs",
    "health": "/api/_a2app"
  }
}
