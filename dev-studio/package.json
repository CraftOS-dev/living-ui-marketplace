{
  "name": "development-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local development workspace with Monaco, real execution and isolated CraftBot or standalone agent work.",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2app/adapter-core": "file:vendor/a2app-adapter-core-0.1.0-alpha.0.tgz",
    "@a2app/rules": "file:vendor/a2app-rules-0.1.0-alpha.0.tgz",
    "@a2app/sdk": "file:vendor/a2app-sdk-0.1.0-alpha.0.tgz",
    "@hono/node-server": "^2.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "agent-app-framework": "file:vendor/agent-app-framework-0.1.0-alpha.0.tgz",
    "better-sqlite3": "^13.0.3",
    "dompurify": "3.4.17",
    "hono": "^4.13.8",
    "marked": "14.0.0",
    "monaco-editor": "0.57.0",
    "node-pty": "^1.1.0",
    "prettier": "3.9.10",
    "pyright": "1.1.414",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "studio-typescript-service": "npm:typescript@6.0.3",
    "typescript": "7.0.2",
    "typescript-language-server": "6.0.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@a2app/rules": "$@a2app/rules",
    "@a2app/sdk": "$@a2app/sdk",
    "dompurify": "3.4.17"
  },
  "scripts": {
    "start": "node server.mjs",
    "build": "vite build",
    "dev:ui": "vite",
    "test": "node --test test/*.test.mjs",
    "framework": "node node_modules/agent-app-framework/dist/agent-app.js",
    "a2app": "node node_modules/agent-app-framework/dist/a2app.js",
    "smoke": "node scripts/smoke.mjs",
    "package": "node scripts/package.mjs"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "node-pty@1.1.0": true
  }
}
